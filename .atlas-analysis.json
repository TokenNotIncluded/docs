  "keyFeatures": [
    "Hosted checkout with 50+ APAC and global payment methods",
    "Merchant of Record model with automatic tax calculation",
    "Virtual item and bundle product catalog management",
    "Recurring subscriptions with trial periods and dunning",
    "Order management with delivery registration and dispute protection",
    "Gift code and free item campaign system for player rewards",
    "Webhook-driven fulfillment with signature verification",
    "Test mode with simulated payments and disputes"
  ],
