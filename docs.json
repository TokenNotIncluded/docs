{
  "$schema": "https://mintlify.com/docs.json",
  "name": "LMM API 文档",
  "theme": "almond",
  "colors": {
    "primary": "#0E7490",
    "light": "#22D3EE",
    "dark": "#155E75"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "openapi": ["docs/openapi/api.json", "docs/openapi/relay.json"],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "go"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      { "label": "API 状态", "href": "https://api.lmm.best" },
      { "label": "GitHub", "href": "https://github.com/TokenNotIncluded/api.lmm.best" }
    ],
    "primary": {
      "type": "button",
      "label": "API 参考",
      "href": "/docs/api-reference"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "开始使用",
        "icon": "rocket",
        "pages": ["introduction", "docs/authentication", "docs/api-reference"]
      },
      {
        "group": "API 端点",
        "icon": "brackets",
        "pages": [
          {
            "group": "中继 API（模型与媒体）",
            "icon": "bot",
            "expanded": true,
            "openapi": "docs/openapi/relay.json"
          },
          {
            "group": "管理 API（面板与运维）",
            "icon": "settings-2",
            "expanded": true,
            "openapi": "docs/openapi/api.json"
          },
          {
            "group": "端点专题",
            "icon": "plug-zap",
            "expanded": true,
            "pages": [
              "docs/responses-tool-compatibility",
              "docs/read-only-query-api",
              "docs/ali-image-polling",
              "docs/pi-remote-control-api"
            ]
          }
        ]
      },
      {
        "group": "部署与运维",
        "icon": "server-cog",
        "pages": [
          {
            "group": "部署与环境",
            "icon": "cloud-upload",
            "expanded": true,
            "pages": [
              "docs/backend-cli-deployment-contract",
              "docs/manual-systemd-deployment",
              "docs/three-node-deployment",
              "docs/seamless-upgrades",
              "docs/setup-startup",
              "docs/production-release-transaction"
            ]
          },
          {
            "group": "数据与缓存",
            "icon": "database",
            "expanded": true,
            "pages": [
              "docs/postgresql-migration",
              "docs/postgresql-cutover",
              "docs/valkey-lmm-api"
            ]
          },
          {
            "group": "运行时与诊断",
            "icon": "activity",
            "expanded": true,
            "pages": [
              "docs/release-architecture",
              "docs/rust-blue-green",
              "docs/rust-relay-timeouts",
              "docs/go-memory-management",
              "docs/pprof-diagnostics",
              "docs/server-ops"
            ]
          }
        ]
      },
      {
        "group": "计费与支付",
        "icon": "credit-card",
        "pages": [
          "docs/model-price-locks",
          "docs/price-lock-snapshot-consistency",
          "docs/payment-money-contract",
          "docs/cc-switch-account-balance",
          "docs/referral-rewards",
          "docs/open-source-bounties"
