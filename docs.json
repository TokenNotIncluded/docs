{
  "$schema": "https://mintlify.com/docs.json",
  "name": "LMM API 文档",
  "description": "LMM API 文档说明如何创建 API Key，并用 OpenAI、Anthropic 与 Gemini 协议接入 Claude Code、Codex 等客户端。LMM Forge 是同一平台上的开源赏金协作服务，由 LIghtJUNction 运营。",
  "theme": "almond",
  "colors": {
    "primary": "#0E7490",
    "light": "#22D3EE",
    "dark": "#155E75"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://api.lmm.best"
  },
  "api": {
    "openapi": [
      "docs/openapi/api.json",
      "docs/openapi/relay.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/TokenNotIncluded/api.lmm.best"
      }
    ],
    "primary": {
      "type": "button",
      "label": "控制台",
      "href": "https://api.lmm.best"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "LMM API 文档",
      "og:type": "website",
      "twitter:card": "summary"
    },
    "organization": {
      "id": "https://api.lmm.best/#organization",
      "name": "LMM API",
      "legalName": "LIghtJUNction",
      "url": "https://api.lmm.best",
      "sameAs": [
        "https://github.com/TokenNotIncluded/api.lmm.best"
      ]
    }
